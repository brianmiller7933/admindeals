---
const domain = "AdminDeals.com";
const email = "brian@milleradesman.com";
const subject = encodeURIComponent("Offer for AdminDeals.com");
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />

		<title>AdminDeals.com | Premium Domain for Sale</title>

		<meta
			name="description"
			content="AdminDeals.com is a premium, memorable domain available for acquisition."
		/>

		<style>
			* {
				box-sizing: border-box;
			}

			html {
				scroll-behavior: smooth;
			}

			body {
				margin: 0;
				font-family:
					Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
					"Segoe UI", sans-serif;
				background:
					radial-gradient(circle at top, #172554 0%, #0f172a 40%, #020617 100%);
				color: #f8fafc;
				min-height: 100vh;
			}

			.page {
				min-height: 100vh;
				display: flex;
				flex-direction: column;
			}

			header {
				width: min(1120px, calc(100% - 48px));
				margin: 0 auto;
				padding: 28px 0;
				display: flex;
				align-items: center;
				justify-content: space-between;
			}

			.logo {
				font-size: 21px;
				font-weight: 800;
				letter-spacing: -0.03em;
			}

			.header-link {
				color: #cbd5e1;
				text-decoration: none;
				font-size: 15px;
				font-weight: 600;
			}

			.header-link:hover {
				color: white;
			}

			main {
				flex: 1;
				width: min(980px, calc(100% - 48px));
				margin: 0 auto;
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 70px 0 110px;
			}

			.hero {
				width: 100%;
				text-align: center;
			}

			.badge {
				display: inline-flex;
				align-items: center;
				gap: 8px;
				padding: 8px 14px;
				border: 1px solid rgba(255,255,255,.14);
				border-radius: 999px;
				background: rgba(255,255,255,.06);
				color: #cbd5e1;
				font-size: 14px;
				font-weight: 600;
				margin-bottom: 30px;
			}

			.dot {
				width: 8px;
				height: 8px;
				border-radius: 50%;
				background: #22c55e;
				box-shadow: 0 0 14px rgba(34,197,94,.8);
			}

			h1 {
				margin: 0;
				font-size: clamp(54px, 9vw, 104px);
				line-height: .95;
				letter-spacing: -0.07em;
				font-weight: 850;
			}

			.gradient {
				background: linear-gradient(90deg, #ffffff, #93c5fd);
				-webkit-background-clip: text;
				background-clip: text;
				color: transparent;
			}

			.subtitle {
				max-width: 700px;
				margin: 30px auto 0;
				font-size: clamp(19px, 2.3vw, 25px);
				line-height: 1.55;
				color: #cbd5e1;
			}

			.actions {
				display: flex;
				justify-content: center;
				gap: 14px;
				flex-wrap: wrap;
				margin-top: 38px;
			}

			.button {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				min-width: 175px;
				padding: 15px 24px;
				border-radius: 12px;
				text-decoration: none;
				font-weight: 750;
				font-size: 16px;
				transition: transform .15s ease, opacity .15s ease;
			}

			.button:hover {
				transform: translateY(-2px);
			}

			.primary {
				background: #ffffff;
				color: #0f172a;
			}

			.secondary {
				border: 1px solid rgba(255,255,255,.18);
				background: rgba(255,255,255,.06);
				color: white;
			}

			.features {
				margin: 75px auto 0;
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 16px;
				max-width: 880px;
			}

			.card {
				text-align: left;
				padding: 24px;
				border: 1px solid rgba(255,255,255,.1);
				border-radius: 18px;
				background: rgba(255,255,255,.045);
				backdrop-filter: blur(10px);
			}

			.card-title {
				font-weight: 750;
				font-size: 17px;
				margin-bottom: 8px;
			}

			.card-text {
				margin: 0;
				color: #94a3b8;
				line-height: 1.55;
				font-size: 14px;
			}

			.contact {
				margin: 72px auto 0;
				padding-top: 38px;
				border-top: 1px solid rgba(255,255,255,.1);
				max-width: 680px;
			}

			.contact h2 {
				margin: 0 0 12px;
				font-size: 26px;
				letter-spacing: -0.03em;
			}

			.contact p {
				margin: 0;
				color: #94a3b8;
				line-height: 1.6;
			}

			.email {
				display: inline-block;
				margin-top: 18px;
				color: #bfdbfe;
				text-decoration: none;
				font-weight: 650;
			}

			.email:hover {
				color: white;
			}

			footer {
				width: min(1120px, calc(100% - 48px));
				margin: 0 auto;
				padding: 28px 0 34px;
				display: flex;
				justify-content: space-between;
				gap: 20px;
				flex-wrap: wrap;
				color: #64748b;
				font-size: 13px;
				border-top: 1px solid rgba(255,255,255,.07);
			}

			@media (max-width: 760px) {
				header {
					width: min(100% - 32px, 1120px);
				}

				main {
					width: min(100% - 32px, 980px);
					padding-top: 50px;
				}

				.features {
					grid-template-columns: 1fr;
				}

				.card {
					text-align: center;
				}

				footer {
					width: min(100% - 32px, 1120px);
					flex-direction: column;
					text-align: center;
				}
			}
		</style>
	</head>

	<body>
		<div class="page">
			<header>
				<div class="logo">{domain}</div>

				<a
					class="header-link"
					href={`mailto:${email}?subject=${subject}`}
				>
					Contact Owner
				</a>
			</header>

			<main>
				<section class="hero">
					<div class="badge">
						<span class="dot"></span>
						Available for acquisition
					</div>

					<h1 class="gradient">{domain}</h1>

					<p class="subtitle">
						A premium, memorable .com domain for a smarter business.
						Ideal for administrative services, business software,
						B2B marketplaces, procurement, professional services,
						or business deals and discounts.
					</p>

					<div class="actions">
						<a
							class="button primary"
							href={`mailto:${email}?subject=${subject}`}
						>
							Make an Offer
						</a>

						<a class="button secondary" href="#contact">
							Contact Owner
						</a>
					</div>

					<div class="features">
						<div class="card">
							<div class="card-title">Memorable</div>
							<p class="card-text">
								Short, clear, easy to spell, and easy for customers to remember.
							</p>
						</div>

						<div class="card">
							<div class="card-title">Commercial</div>
							<p class="card-text">
								A natural fit for business services, software, marketplaces, and B2B brands.
							</p>
						</div>

						<div class="card">
							<div class="card-title">Versatile</div>
							<p class="card-text">
								Broad enough to support multiple business models as a company grows.
							</p>
						</div>
					</div>

					<div class="contact" id="contact">
						<h2>Interested in acquiring {domain}?</h2>

						<p>
							Contact the domain owner directly to discuss an offer.
							Secure transfer can be completed through an established
							domain marketplace or escrow provider.
						</p>

						<a
							class="email"
							href={`mailto:${email}?subject=${subject}`}
						>
							{email}
						</a>
					</div>
				</section>
			</main>

			<footer>
				<span>© {new Date().getFullYear()} {domain}</span>
				<span>Premium domain available for acquisition.</span>
			</footer>
		</div>
	</body>
</html>
