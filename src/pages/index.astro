const colors = palette[site.category];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{site.domain} | Domain Available</title>
		<meta name="description" content={`${site.domain} is available for acquisition.`} />
		<style define:vars={{ accent: colors.accent, accent2: colors.accent2, glow: colors.glow }}>
			* { box-sizing: border-box; }
			html { scroll-behavior: smooth; }
			body {
				margin: 0;
				min-height: 100vh;
				font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
				background: #060914;
				color: #f8fafc;
			}
			body::before {
				content: "";
				position: fixed;
				inset: 0;
				pointer-events: none;
				background:
					radial-gradient(circle at 15% 12%, rgba(var(--glow), .18), transparent 32%),
					radial-gradient(circle at 85% 78%, rgba(var(--glow), .10), transparent 28%),
					linear-gradient(135deg, #080d1e 0%, #060914 55%, #0a1022 100%);
				z-index: -2;
			}
			body::after {
				content: "";
				position: fixed;
				inset: 0;
				pointer-events: none;
				background-image: linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px);
				background-size: 48px 48px;
				mask-image: linear-gradient(to bottom, black, transparent 80%);
				z-index: -1;
			}
			.page { min-height: 100vh; display: flex; flex-direction: column; }
			header {
				width: min(1120px, calc(100% - 48px));
				margin: 0 auto;
				padding: 28px 0;
				display: flex;
				align-items: center;
				justify-content: space-between;
			}
			.wordmark { font-size: 18px; font-weight: 800; letter-spacing: -.04em; }
			.header-link { color: #cbd5e1; text-decoration: none; font-size: 14px; font-weight: 700; }
			.header-link:hover { color: white; }
			main {
				flex: 1;
				width: min(1040px, calc(100% - 48px));
				margin: 0 auto;
				display: grid;
				place-items: center;
				padding: 64px 0 90px;
			}
			.hero { width: 100%; text-align: center; }
			.badge {
				display: inline-flex;
				align-items: center;
				gap: 9px;
				padding: 9px 14px;
				border: 1px solid rgba(255,255,255,.13);
				border-radius: 999px;
				background: rgba(255,255,255,.055);
				color: #cbd5e1;
				font-size: 13px;
				font-weight: 750;
				letter-spacing: .02em;
				margin-bottom: 32px;
				backdrop-filter: blur(12px);
			}
			.dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 18px rgba(var(--glow), .9); }
			h1 {
				margin: 0;
				font-size: clamp(42px, 8.2vw, 92px);
				line-height: .98;
				letter-spacing: -.065em;
				font-weight: 880;
				overflow-wrap: anywhere;
				background: linear-gradient(110deg, #fff 18%, var(--accent) 62%, var(--accent2));
				-webkit-background-clip: text;
				background-clip: text;
				color: transparent;
			}
			.subtitle { max-width: 760px; margin: 28px auto 0; color: #b7c1d1; font-size: clamp(18px, 2vw, 23px); line-height: 1.58; }
			.actions { display: flex; justify-content: center; gap: 14px; flex-wrap: wrap; margin-top: 38px; }
			.button {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				min-width: 178px;
				padding: 15px 23px;
				border-radius: 12px;
				text-decoration: none;
				font-weight: 800;
				font-size: 15px;
				transition: transform .16s ease, box-shadow .16s ease;
			}
			.button:hover { transform: translateY(-2px); }
			.primary { background: linear-gradient(135deg, var(--accent), var(--accent2)); color: #07111d; box-shadow: 0 14px 38px rgba(var(--glow), .18); }
			.secondary { border: 1px solid rgba(255,255,255,.16); background: rgba(255,255,255,.055); color: white; }
			.uses { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; max-width: 860px; margin: 68px auto 0; }
			.use {
				padding: 22px 18px;
				border: 1px solid rgba(255,255,255,.09);
				border-radius: 16px;
				background: rgba(255,255,255,.035);
				color: #d7deea;
				font-size: 15px;
				font-weight: 730;
				backdrop-filter: blur(10px);
			}
			.contact { max-width: 760px; margin: 62px auto 0; padding: 38px 28px 0; border-top: 1px solid rgba(255,255,255,.09); }
			.contact h2 { margin: 0 0 11px; font-size: 25px; letter-spacing: -.03em; }
			.contact p { margin: 0; color: #8f9bad; line-height: 1.65; font-size: 15px; }
			.contact-options { display: flex; align-items: center; justify-content: center; gap: 10px 22px; flex-wrap: wrap; margin-top: 18px; }
			.contact-options a { color: var(--accent); text-decoration: none; font-weight: 760; }
			.contact-options a:hover { color: white; }
			.notice { max-width: 740px; margin: 28px auto 0; color: #697588; font-size: 12px; line-height: 1.55; }
			footer {
				width: min(1120px, calc(100% - 48px));
				margin: 0 auto;
				padding: 28px 0 34px;
				display: flex;
				justify-content: space-between;
				gap: 18px;
				flex-wrap: wrap;
				color: #566276;
				font-size: 12px;
				border-top: 1px solid rgba(255,255,255,.06);
			}
			@media (max-width: 700px) {
				header, footer { width: min(100% - 32px, 1120px); }
				main { width: min(100% - 32px, 1040px); padding-top: 46px; }
				.uses { grid-template-columns: 1fr; }
				.contact { padding-inline: 0; }
				footer { flex-direction: column; text-align: center; }
			}
		</style>
	</head>
	<body>
		<div class="page">
			<header>
				<div class="wordmark">{site.domain}</div>
				<a class="header-link" href={`mailto:${email}?subject=${subject}`}>Contact Owner</a>
			</header>
			<main>
				<section class="hero">
					<div class="badge"><span class="dot"></span>Available for acquisition</div>
					<h1>{site.domain}</h1>
					<p class="subtitle">{site.description}</p>
					<div class="actions">
						<a class="button primary" href={`mailto:${email}?subject=${subject}`}>Make an Inquiry</a>
						<a class="button secondary" href={`tel:${phoneHref}`}>Call Owner</a>
					</div>
					<div class="uses">
						{site.uses.map((use) => <div class="use">{use}</div>)}
					</div>
					<div class="contact">
						<h2>Interested in {site.domain}?</h2>
						<p>Contact the owner directly for additional information or to discuss acquiring this domain.</p>
						<div class="contact-options">
							<a href={`mailto:${email}?subject=${subject}`}>{email}</a>
							<a href={`tel:${phoneHref}`}>{phoneDisplay}</a>
						</div>
					</div>
					{site.category === "health" && <p class="notice">This website does not provide medical advice, prescriptions, products, or healthcare services. Any future use must comply with all applicable licensing, advertising, and healthcare laws.</p>}
					{site.personal && <p class="notice">This independently owned website is not affiliated with, authorized by, or endorsed by any person or organization that may share this name.</p>}
				</section>
			</main>
			<footer>
				<span>© {new Date().getFullYear()} {site.domain}</span>
				<span>Domain available for acquisition.</span>
			</footer>
		</div>
	</body>
</html>
